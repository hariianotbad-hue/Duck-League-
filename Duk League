        </div>

        <div class="card">
            <h3>MEMBER</h3>
            <p>Official members of the DUK LEAGUE community.</p>
        </div>

        <div class="card">
            <h3>RECRUIT</h3>
            <p>New ducks entering the battlefield.</p>
        </div>

    </div>
</section>

<section id="roster">
    <h2 class="section-title">THE <span>ROSTER</span></h2>

    <p class="subtitle">
        Meet the members of DUK LEAGUE.
        This roster is shared across visitors.
    </p>

    <div class="roster-box">

        <div class="roster-header">
            <h3>MEMBERS</h3>
            <span class="member-count" id="memberCount">Loading...</span>
        </div>

        <div id="rosterList">
            <div class="empty">Connecting to the database...</div>
        </div>

    </div>
</section>

<footer>
    © 2026 <span>DUK LEAGUE</span> — ALL DUCKS RESERVED.
</footer>

<!-- JOIN MODAL -->

<div class="modal" id="joinModal">

    <div class="modal-content">

        <div class="modal-top">
            <h2>SELECT YOUR DUCK</h2>
            <button class="close" onclick="closeJoin()">×</button>
        </div>

        <p class="subtitle">
            Choose your identity. Once selected, the name is taken.
        </p>

        <div class="name-grid" id="nameGrid"></div>

        <div id="message"></div>

        <p class="status">
            Names are shared through the DUK LEAGUE cloud database.
        </p>

    </div>

</div>

